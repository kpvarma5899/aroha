DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@aroha.local"
ADMIN_PASSWORD="change-me"

# Optional. LLM briefing for who should be questioned. Roster names still come from sourced records.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Optional. Without Twilio, OTP and case WhatsApp messages are printed in the server log in development.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Optional. Desk posts on X from the admin case page (residents do not get a Post on X button).
# Create an X developer app with Read and Write, then user access tokens (OAuth 1.0a).
# Without these, the draft is logged on the server.
TWITTER_API_KEY=""
TWITTER_API_SECRET=""
TWITTER_ACCESS_TOKEN=""
TWITTER_ACCESS_TOKEN_SECRET=""

# Optional. Send the letter to published office emails on file. Without this, drafts print in the server log.
RESEND_API_KEY=""
EMAIL_FROM="Aroha <noreply@localhost>"

# Optional. Protect POST /api/jobs/tick for a scheduler. Staff can also run jobs from the desk.
CRON_SECRET=""
